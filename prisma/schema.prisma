generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  User
  Supplier
}

enum JwtTokenType {
  acess
  reset
}

model Admin {
  id       String      @id @default(uuid())
  email    String      @unique
  password String
  name     String
  role     Role        @default(Admin)
  adminJWT AdminJWTs[]
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String?
  name         String
  cpf          String?       @unique
  googleId     String?       @unique
  birthday     String?
  phoneNumber  String?       @unique
  address      String?
  role         Role          @default(User)
  userJWT      UserJWTs[]
  reservations Reservation[]
}

model Supplier {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  name        String
  cnpj        String         @unique
  phoneNumber String
  address     String
  role        Role           @default(Supplier)
  products    Product[]
  supplierJWT SupplierJWTs[]
}

model Product {
  id          String          @id @default(uuid())
  name        String
  description String
  price       Decimal
  imagesUrl   String[]
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  departures  TourDeparture[]
}

enum DepartureStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AttendanceStatus {
  NOT_RECORDED
  BOARDED
  NO_SHOW
}

model TourDeparture {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  startsAt       DateTime        @db.Timestamptz(3)
  timeZone       String          @default("America/Maceio")
  capacity       Int
  pricePerPerson Decimal         @db.Decimal(12, 2)
  status         DepartureStatus @default(SCHEDULED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  reservations   Reservation[]

  @@unique([productId, startsAt])
  @@index([startsAt, status])
}

model Reservation {
  id                 String                   @id @default(uuid())
  departureId        String
  departure          TourDeparture            @relation(fields: [departureId], references: [id], onDelete: Restrict)
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  responsibleName    String
  requestKey         String
  status             ReservationStatus        @default(PENDING)
  pricePerPerson     Decimal                  @db.Decimal(12, 2)
  totalPrice         Decimal                  @db.Decimal(14, 2)
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  participants       ReservationParticipant[]
  events             ReservationEvent[]

  @@unique([userId, requestKey])
  @@index([departureId, status])
  @@index([userId, createdAt])
}

model ReservationParticipant {
  id            String           @id @default(uuid())
  reservationId String
  reservation   Reservation      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  name          String
  attendance    AttendanceStatus @default(NOT_RECORDED)
  recordedAt    DateTime?
  recordedBy    String?

  @@index([reservationId, attendance])
}

model ReservationEvent {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorId       String
  actorRole     Role
  action        String
  details       Json
  createdAt     DateTime    @default(now())

  @@index([reservationId, createdAt])
}

model UserJWTs {
  id        Int          @id @default(autoincrement())
  token     String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      JwtTokenType @default(acess)
}

model SupplierJWTs {
  id         Int          @id @default(autoincrement())
  token      String       @unique
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type       JwtTokenType @default(acess)
}

model AdminJWTs {
  id        Int          @id @default(autoincrement())
  token     String       @unique
  expiresAt DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  adminId   String //@unique
  admin     Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type      JwtTokenType @default(acess)
}
