generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  User
  Supplier
}

enum JwtTokenType {
  acess
  reset
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Admin {
  id       String      @id @default(uuid())
  email    String      @unique
  password String
  name     String
  role     Role        @default(Admin)
  adminJWT AdminJWTs[]
}

model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String?
  name        String
  cpf         String?    @unique
  document    String?    @unique // CPF ou CNPJ
  isB2B       Boolean    @default(false)
  googleId    String?    @unique 
  birthday    String?
  phoneNumber String?    @unique
  address     String?
  role        Role       @default(User)
  userJWT     UserJWTs[]
  bookings    Booking[]
}

model Supplier {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  name        String
  cnpj        String         @unique
  phoneNumber String
  address     String
  walletId    String?        @unique // ID da carteira/subconta no Gateway para Split
  role        Role           @default(Supplier)
  products    Product[]
  supplierJWT SupplierJWTs[]
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  price       Decimal
  imagesUrl   String[]
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Booking {
  id               String        @id @default(uuid())
  userId           String
  productId        String
  totalAmount      Decimal       @db.Decimal(10, 2)
  platformFee      Decimal       @db.Decimal(10, 2)
  supplierAmount   Decimal       @db.Decimal(10, 2)
  status           BookingStatus @default(PENDING)
  paymentGatewayId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model UserJWTs {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      JwtTokenType @default(acess)
}

model SupplierJWTs {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type       JwtTokenType @default(acess)
}

model AdminJWTs {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adminId   String   //@unique
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  type      JwtTokenType @default(acess)
}
