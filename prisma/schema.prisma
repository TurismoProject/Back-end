generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  User
  Supplier
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(Admin)

  // authenticate Authenticate?
}

model User {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  name        String
  cpf         String @unique
  birthday    String
  phoneNumber String @unique
  address     String
  role        Role   @default(User)

  // authenticate Authenticate?
}

model Supplier {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  companyName String
  cnpj        String @unique
  phoneNumber String
  address     String
  role        Role   @default(Supplier)
  products    Product[]

  // authenticate Authenticate?
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal
  imagesUrl   String[]
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Authenticate {
  id          String    @id @default(uuid())
  accountId   String?   @unique 
  type        Role      @default(User)
  token       String    @unique
  expiresAt   DateTime  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  // adminId     String?   @unique
  // user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // userId      String?   @unique
  // supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  // supplierId  String?   @unique

  // @@index([adminId])
  // @@index([userId])
  // @@index([supplierId])
}



