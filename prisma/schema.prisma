generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  User
  Supplier
}

model Admin {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  role     Role   @default(Admin)
}

model User {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  name        String
  cpf         String
  birthday    String
  phoneNumber String
  address     String
  role        Role   @default(User)
}

model Supplier {
  id          String @id @default(uuid())
  email       String @unique
  password    String
  companyName String
  cnpj        String @unique
  phoneNumber String
  address     String
  role        Role   @default(Supplier)
  products    Product[]
}


model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal
  imagesUrl   String[]
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Authenticate {
  id        String   @id @default(uuid()) 
  token     String   @unique              
  userId    String                        
  userType  Role                          
  expiresAt DateTime                      
  createdAt DateTime @default(now())      
  updatedAt DateTime @updatedAt           
}

