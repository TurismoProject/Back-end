generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  User
  Supplier
}

model Admin {
  id       String      @id @default(uuid())
  email    String      @unique
  password String
  name     String
  role     Role        @default(Admin)
  adminJWT AdminJWTs[]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  cpf             String           @unique
  googleId        String?          @unique
  birthday        String
  phoneNumber     String           @unique
  address         String
  role            Role             @default(User)
  userJWT         UserJWTs[]
  productReviews  ProductReview[]
  supplierReviews SupplierReview[]
}

model Supplier {
  id          String           @id @default(uuid())
  email       String           @unique
  password    String
  name        String
  cnpj        String           @unique
  phoneNumber String
  address     String
  role        Role             @default(Supplier)
  products    Product[]
  supplierJWT SupplierJWTs[]
  reviews     SupplierReview[]
}

model Product {
  id              String                  @id @default(uuid())
  name            String
  description     String
  price           Decimal
  rating          Decimal                 @default(0)
  categories      Category[]
  bucketName      String
  imagesPositions ProductImagesPosition[]
  supplierId      String
  supplier        Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  reviews         ProductReview[]
}

model ProductImagesPosition {
  id        String  @id @default(uuid())
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  imageName String
}

model ProductReview {
  id          String  @id @default(uuid())
  title       String
  description String
  rating      Decimal @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  User        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model SupplierReview {
  id          String   @id @default(uuid())
  title       String
  description String
  rating      Decimal  @default(0)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId  String
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

enum Category {
  HOTEL
  BUNDLE
  TOUR
  RESTAURANT
  TRANSPORT
  CRAFTWORK
  AQUATIC
}

model UserJWTs {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupplierJWTs {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model AdminJWTs {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}
