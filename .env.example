# Porta da API
PORT=3000

# URL do Frontend (para onde o Google redireciona após autenticação)
FRONTEND_URL=http://localhost:5173

# Banco de dados PostgreSQL (exemplo com o docker-compose local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Chaves JWT (Chaves RSA em formato Base64)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Configurações de Google OAuth 2.0
# Obtenha em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
# Importante: A rota tem prefixo /usuario/ pois o controller é @Controller('usuario')
GOOGLE_CALLBACK_URL="http://localhost:3000/usuario/auth/google/callback"

# Envio de E-mails
HOST="smtp.gmail.com"
PORT_EMAIL=587
USER_EMAIL="seu-email@gmail.com"
PASS="sua-senha-de-app"
EMAIL_DEFAULT="seu-email@gmail.com"
PROVIDER_URL="http://localhost:3000"

# Firebase Storage (necessário para enviar imagens dos produtos)
# Use a configuração real do projeto Firebase; não publique credenciais no Git.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
